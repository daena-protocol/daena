{
  "name": "@daena/sdk",
  "version": "0.1.0-alpha.0",
  "description": "Agent-side SDK for the Daena Protocol — verified-by-default reads and capability invocation",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["src", "dist"],
  "repository": {
    "type": "git",
    "url": "https://github.com/daena-protocol/daena.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://daena-protocol.org",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@daena/core": "0.1.0-alpha.0",
    "@daena/verifier": "0.1.0-alpha.0"
  }
}
